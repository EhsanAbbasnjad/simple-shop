@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;700&display=swap');

body {
  margin: 0;
  padding: 0;
  font-family: 'Vazirmatn', sans-serif;
  background: linear-gradient(to bottom right, #e0e7ff, #c7d2fe);
  direction: rtl;
}

.main-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
}

.selector-box,
.content-box {
  background-color: white;
  padding: 3rem;
  border-radius: 24px;
  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
  text-align: center;
  max-width: 600px;
  width: 100%;
}

.question {
  font-size: 2rem;
  font-weight: bold;
  color: #1e293b;
  margin-bottom: 2rem;
}

.button-container {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.option-btn {
  padding: 1rem 2rem;
  font-size: 1.1rem;
  font-weight: bold;
  border: none;
  border-radius: 16px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.option-btn.ongoing {
  background-color: #e0f2fe;
  color: #0284c7;
  border: 2px solid #0284c7;
}

.option-btn.ongoing:hover {
  background-color: #bae6fd;
}

.option-btn.completed {
  background-color: #d1fae5;
  color: #059669;
  border: 2px solid #059669;
}

.option-btn.completed:hover {
  background-color: #a7f3d0;
}

.title {
  font-size: 1.8rem;
  font-weight: bold;
  margin-bottom: 1.5rem;
}

.title.ongoing {
  color: #0ea5e9;
}

.title.completed {
  color: #10b981;
}

.list {
  list-style: none;
  padding: 0;
  margin-bottom: 2rem;
  font-size: 1.1rem;
}

.back-btn {
  background-color: #fcd34d;
  color: #92400e;
  font-weight: bold;
  padding: 0.75rem 2rem;
  border: none;
  border-radius: 12px;
  cursor: pointer;
  transition: background 0.3s;
}

.back-btn:hover {
  background-color: #fbbf24;
}
